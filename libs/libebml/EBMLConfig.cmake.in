@PACKAGE_INIT@

# MKVToolNix-Mod: the static library's link interface names utf8cpp::utf8cpp
# (when utf8cpp was found at build time), so a user of this package needs it
include(CMakeFindDependencyMacro)
find_dependency(utf8cpp)

include(${CMAKE_CURRENT_LIST_DIR}/EBMLTargets.cmake)

check_required_components(EBML)
